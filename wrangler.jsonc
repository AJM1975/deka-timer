{
  // Staging only. Production DNS and deployment remain unchanged.
  "name": "racesplit",
  "compatibility_date": "2026-10-10",
  "assets": { "directory": ".", "binding": "ASSETS", "run_worker_first": ["/api/*"], "exclude": ["project/**", "tests/**", "src/**", "node_modules/**", "package.json", "package-lock.json", "wrangler.jsonc", ".github/**"] },
  "main": "src/worker.mjs",
  "env": {
    "staging": {
      "name": "racesplit-staging",
      "vars": { "ENVIRONMENT": "staging" }
    }
  }
}
